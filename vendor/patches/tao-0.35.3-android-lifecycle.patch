+/// Owned target captured while the Activity is alive. Keeping its WindowManager
+/// distinguishes this Activity from a later Activity reusing the same integer ID.
+#[derive(Clone)]
+pub struct ActivityWindowTarget {
+  pub(crate) activity_id: ActivityId,
+  pub(crate) activity_name: String,
+  pub(crate) window_manager: GlobalRef,
+}
+
+/// Capture on Android's main thread after Activity setup, before scheduling
+/// asynchronous creation on the Rust event-loop thread.
+pub fn capture_activity(activity_id: ActivityId) -> Option<ActivityWindowTarget> {
+  let context = CONTEXTS.lock().unwrap().get(&activity_id)?.clone();
+  Some(ActivityWindowTarget {
+    activity_id,
+    activity_name: context.activity_name,
+    window_manager: activity_window_manager(activity_id)?,
+  })
+}
+
+thread_local! {
+  static REQUESTED_ACTIVITY: std::cell::RefCell<Option<ActivityWindowTarget>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Scope window creation to one already registered Activity. Unlike choosing
+/// the next available Activity, a destroyed target cannot bind a replacement.
+/// Invoke on the event-loop thread that performs the actual window creation.
+pub fn with_activity<R>(target: ActivityWindowTarget, create: impl FnOnce() -> R) -> R {
+  struct Restore(Option<ActivityWindowTarget>);
+  impl Drop for Restore {
+    fn drop(&mut self) {
+      REQUESTED_ACTIVITY.with(|slot| *slot.borrow_mut() = self.0.take());
+    }
+  }
+  let _restore = Restore(REQUESTED_ACTIVITY.with(|slot| slot.replace(Some(target))));
+  create()
+}
+
+pub(crate) fn requested_activity() -> Option<ActivityWindowTarget> {
+  REQUESTED_ACTIVITY.with(|slot| slot.borrow().clone())
+}
+
 pub static PIPE: Lazy<[OwnedFd; 2]> = Lazy::new(|| {
   let mut pipe: [RawFd; 2] = Default::default();
   unsafe { libc::pipe(pipe.as_mut_ptr()) };
