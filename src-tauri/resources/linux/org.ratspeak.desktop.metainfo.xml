<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.ratspeak.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-Reticulum-License</project_license>
  <name>Ratspeak</name>
  <summary>End-to-end encrypted mesh messenger</summary>
  <description>
    <p>
      Ratspeak is an end-to-end encrypted messenger for desktop, mobile, and LoRa handhelds.
      If the internet goes down, messages can still travel over Wi-Fi, Bluetooth, or radio.
    </p>
    <p>
      There is no sign-up. Ratspeak makes your address on your device, and it says nothing
      about who you are. It is built on Reticulum and speaks LXMF, so it works with other
      Reticulum apps.
    </p>
    <ul>
      <li>Messages, photos, and files, end-to-end encrypted</li>
      <li>Connects over the internet, your local network, Bluetooth, or a LoRa radio</li>
      <li>Free and open source, with no account or phone number</li>
    </ul>
  </description>
  <developer_name>Ratspeak LLC</developer_name>
  <developer id="org.ratspeak">
    <name>Ratspeak LLC</name>
  </developer>
  <url type="homepage">https://ratspeak.org</url>
  <url type="help">https://docs.ratspeak.org</url>
  <url type="bugtracker">https://github.com/ratspeak/Ratspeak/issues</url>
  <url type="vcs-browser">https://github.com/ratspeak/Ratspeak</url>
  <launchable type="desktop-id">Ratspeak.desktop</launchable>
  <icon type="stock">ratspeak</icon>
  <branding>
    <color type="primary" scheme_preference="light">#f1f5ff</color>
    <color type="primary" scheme_preference="dark">#0a0f2e</color>
  </branding>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-info">mild</content_attribute>
  </content_rating>
  <categories>
    <category>Network</category>
    <category>Chat</category>
    <category>InstantMessaging</category>
  </categories>
  <provides>
    <binary>ratspeak</binary>
  </provides>
</component>
