{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ratspeak",
  "version": "1.0.44",
  "identifier": "org.ratspeak.desktop",
  "build": {
    "frontendDist": "../dashboard"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ratspeak LLC",
    "copyright": "Copyright © 2026 Ratspeak LLC. Includes Rust ports of Mark Qvist's Reticulum, LXMF, and LXST.",
    "homepage": "https://ratspeak.org",
    "category": "SocialNetworking",
    "shortDescription": "End-to-end encrypted mesh messenger",
    "longDescription": "End-to-end encrypted messenger for desktop, mobile, and LoRa handhelds. If the internet goes down, messages can still travel over Wi-Fi, Bluetooth, or radio. Built on Reticulum and LXMF.",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../third_party/btleplug/LICENSE.md": "third-party/btleplug/LICENSE.md",
      "../third_party/opus-rs-0.1.29-COPYING": "third-party/opus-rs-0.1.29-COPYING.txt",
      "../third_party/lxst-codec2/NOTICE": "third-party/lxst-codec2/NOTICE",
      "../third_party/lxst-codec2/licenses/LGPL-2.1.txt": "third-party/lxst-codec2/licenses/LGPL-2.1.txt",
      "../third_party/lxst-codec2/licenses/KISS-FFT-BSD-3-Clause.txt": "third-party/lxst-codec2/licenses/KISS-FFT-BSD-3-Clause.txt",
      "../third_party/lxst-codec2/licenses/upstream-Cargo.toml": "third-party/lxst-codec2/licenses/upstream-Cargo.toml",
      "../third_party/lxst-codec2/licenses/upstream-README.md": "third-party/lxst-codec2/licenses/upstream-README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1000074
    },
    "iOS": {
      "bundleVersion": "1000074",
      "minimumSystemVersion": "15.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/share/metainfo/org.ratspeak.desktop.metainfo.xml": "resources/linux/org.ratspeak.desktop.metainfo.xml",
          "/usr/lib/libayatana-appindicator3.so.1": "resources/linux/appimage-runtime/libayatana-appindicator3.so.1",
          "/usr/lib/libayatana-ido3-0.4.so.0": "resources/linux/appimage-runtime/libayatana-ido3-0.4.so.0",
          "/usr/lib/libayatana-indicator3.so.7": "resources/linux/appimage-runtime/libayatana-indicator3.so.7",
          "/usr/lib/libdbusmenu-glib.so.4": "resources/linux/appimage-runtime/libdbusmenu-glib.so.4",
          "/usr/lib/libdbusmenu-gtk3.so.4": "resources/linux/appimage-runtime/libdbusmenu-gtk3.so.4"
        }
      },
      "deb": {
        "depends": [
          "libpcsclite1",
          "libasound2t64 | libasound2",
          "libudev1"
        ],
        "desktopTemplate": "resources/linux/Ratspeak.desktop",
        "files": {
          "/usr/share/metainfo/org.ratspeak.desktop.metainfo.xml": "resources/linux/org.ratspeak.desktop.metainfo.xml",
          "/usr/lib/udev/rules.d/70-ratspeak.rules": "resources/linux/70-ratspeak.rules"
        },
        "postInstallScript": "resources/linux/udev-postinst.sh"
      },
      "rpm": {
        "depends": [
          "libpcsclite.so.1()(64bit)",
          "libasound.so.2()(64bit)",
          "libudev.so.1()(64bit)"
        ],
        "desktopTemplate": "resources/linux/Ratspeak.desktop",
        "files": {
          "/usr/share/metainfo/org.ratspeak.desktop.metainfo.xml": "resources/linux/org.ratspeak.desktop.metainfo.xml",
          "/usr/lib/udev/rules.d/70-ratspeak.rules": "resources/linux/70-ratspeak.rules"
        },
        "postInstallScript": "resources/linux/udev-postinst.sh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "resources/macos/dmg-background.png",
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "windowSize": {
          "width": 920,
          "height": 500
        },
        "appPosition": {
          "x": 260,
          "y": 246
        },
        "applicationFolderPosition": {
          "x": 660,
          "y": 246
        }
      }
    },
    "windows": {
      "wix": {
        "bannerPath": "resources/windows/wix-banner.bmp",
        "dialogImagePath": "resources/windows/wix-dialog.bmp"
      },
      "nsis": {
        "headerImage": "resources/windows/nsis-header.bmp",
        "sidebarImage": "resources/windows/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  }
}
