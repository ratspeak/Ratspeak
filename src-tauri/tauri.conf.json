{
  "$schema": "https://raw.githubusercontent.com/nicholasgasior/tauri-apps/tauri-v2/crates/tauri-cli/schema.json",
  "productName": "Ratspeak",
  "version": "1.0.34",
  "identifier": "org.ratspeak.desktop",
  "build": {
    "frontendDist": "../dashboard"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Ratspeak Contributors",
    "homepage": "https://github.com/ratspeak/Ratspeak",
    "category": "SocialNetworking",
    "shortDescription": "Ratspeak: An all-in-one Reticulum & LXMF client in Rust.",
    "longDescription": "https://github.com/ratspeak/Ratspeak",
    "resources": {
      "../third_party/btleplug/LICENSE.md": "third-party/btleplug/LICENSE.md",
      "../third_party/opus-rs-0.1.29-COPYING": "third-party/opus-rs-0.1.29-COPYING.txt",
      "../third_party/lxst-codec2/NOTICE": "third-party/lxst-codec2/NOTICE",
      "../third_party/lxst-codec2/licenses/LGPL-2.1.txt": "third-party/lxst-codec2/licenses/LGPL-2.1.txt",
      "../third_party/lxst-codec2/licenses/KISS-FFT-BSD-3-Clause.txt": "third-party/lxst-codec2/licenses/KISS-FFT-BSD-3-Clause.txt",
      "../third_party/lxst-codec2/licenses/upstream-Cargo.toml": "third-party/lxst-codec2/licenses/upstream-Cargo.toml",
      "../third_party/lxst-codec2/licenses/upstream-README.md": "third-party/lxst-codec2/licenses/upstream-README.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1000064
    },
    "iOS": {
      "bundleVersion": "1000064"
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/org.ratspeak.desktop.metainfo.xml": "resources/linux/org.ratspeak.desktop.metainfo.xml",
          "/usr/lib/libayatana-appindicator3.so.1": "resources/linux/appimage-runtime/libayatana-appindicator3.so.1",
          "/usr/lib/libayatana-ido3-0.4.so.0": "resources/linux/appimage-runtime/libayatana-ido3-0.4.so.0",
          "/usr/lib/libayatana-indicator3.so.7": "resources/linux/appimage-runtime/libayatana-indicator3.so.7",
          "/usr/lib/libdbusmenu-glib.so.4": "resources/linux/appimage-runtime/libdbusmenu-glib.so.4",
          "/usr/lib/libdbusmenu-gtk3.so.4": "resources/linux/appimage-runtime/libdbusmenu-gtk3.so.4"
        }
      },
      "deb": {
        "desktopTemplate": "resources/linux/Ratspeak.desktop",
        "files": {
          "/usr/share/metainfo/org.ratspeak.desktop.metainfo.xml": "resources/linux/org.ratspeak.desktop.metainfo.xml",
          "/usr/lib/udev/rules.d/99-ratspeak.rules": "resources/linux/99-ratspeak.rules"
        }
      },
      "rpm": {
        "desktopTemplate": "resources/linux/Ratspeak.desktop",
        "files": {
          "/usr/share/metainfo/org.ratspeak.desktop.metainfo.xml": "resources/linux/org.ratspeak.desktop.metainfo.xml",
          "/usr/lib/udev/rules.d/99-ratspeak.rules": "resources/linux/99-ratspeak.rules"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "resources/macos/dmg-background.png",
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "windowSize": {
          "width": 920,
          "height": 500
        },
        "appPosition": {
          "x": 260,
          "y": 246
        },
        "applicationFolderPosition": {
          "x": 660,
          "y": 246
        }
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; img-src 'self' data: blob:; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  }
}
